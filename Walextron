* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: Arial, Helvetica, sans-serif;

    background: #f7f5ef;

    color: #101a2b;

    line-height: 1.6;

    overflow-x: hidden;
}


/* =========================
   NAVBAR
========================= */

.navbar {
    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    padding: 22px 7%;

    display: flex;

    justify-content: space-between;

    align-items: center;

    background: rgba(247, 245, 239, 0.9);

    backdrop-filter: blur(14px);

    border-bottom: 1px solid rgba(16, 26, 43, 0.08);

    z-index: 1000;
}


.logo {
    color: #101a2b;

    text-decoration: none;

    font-size: 21px;

    font-weight: 900;

    letter-spacing: 2px;
}


.logo span,
footer span {
    color: #287cff;
}


nav {
    display: flex;

    gap: 28px;
}


nav a {
    color: #526070;

    text-decoration: none;

    font-size: 14px;

    transition: 0.3s;
}


nav a:hover {
    color: #287cff;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;

    padding: 150px 7% 90px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 60px;

    position: relative;

    overflow: hidden;
}


.hero::before {
    content: "";

    position: absolute;

    width: 500px;

    height: 500px;

    right: -180px;

    top: 80px;

    background: #dceaff;

    border-radius: 50%;

    filter: blur(70px);

    opacity: 0.7;
}


.hero-content {
    max-width: 680px;

    position: relative;

    z-index: 2;

    animation: fadeUp 1s ease;
}


/* BRAND NAME */

.brand-name {
    font-family:
        Arial Black,
        Arial,
        Helvetica,
        sans-serif;

    font-size: 32px;

    font-weight: 900;

    letter-spacing: 4px;

    margin-bottom: 8px;

    color: #101a2b;

    -webkit-text-stroke:
        0.6px #101a2b;
}


.brand-name span {
    color: #287cff;
}


/* BADGE */

.badge {
    display: inline-block;

    padding: 8px 14px;

    margin-bottom: 25px;

    border: 1px solid #cbd7e8;

    border-radius: 30px;

    background: #ffffff;

    color: #526070;

    font-size: 12px;

    letter-spacing: 1px;
}


/* HERO HEADING */

.hero h1 {
    font-size: clamp(48px, 7vw, 86px);

    line-height: 0.98;

    letter-spacing: -3px;

    margin-bottom: 30px;
}


.hero h1 span {
    color: #287cff;
}


.hero-description {
    max-width: 600px;

    color: #637083;

    font-size: 18px;

    margin-bottom: 35px;
}


/* =========================
   BUTTONS
========================= */

.hero-buttons {
    display: flex;

    gap: 14px;

    flex-wrap: wrap;
}


.button {
    display: inline-block;

    padding: 14px 22px;

    border-radius: 8px;

    text-decoration: none;

    font-size: 14px;

    font-weight: bold;

    transition: 0.3s;
}


.button.primary {
    background: #101a2b;

    color: white;
}


.button.primary:hover {
    background: #287cff;

    transform: translateY(-3px);
}


.button.secondary {
    border: 1px solid #ccd4df;

    color: #101a2b;

    background: white;
}


.button.secondary:hover {
    border-color: #287cff;

    color: #287cff;

    transform: translateY(-3px);
}


/* =========================
   HERO VISUAL
========================= */

.hero-visual {
    width: 360px;

    height: 360px;

    position: relative;

    display: flex;

    justify-content: center;

    align-items: center;

    z-index: 2;
}


.glow {
    position: absolute;

    width: 250px;

    height: 250px;

    background: #287cff;

    border-radius: 50%;

    filter: blur(80px);

    opacity: 0.18;
}


.tech-card {
    width: 300px;

    padding: 25px;

    background: #101a2b;

    border-radius: 18px;

    box-shadow:
        0 30px 70px
        rgba(16, 26, 43, 0.25);

    transform: rotate(4deg);

    animation:
        float 5s ease-in-out infinite;
}


.card-top {
    display: flex;

    gap: 7px;

    margin-bottom: 30px;
}


.card-top span {
    width: 9px;

    height: 9px;

    background: #718096;

    border-radius: 50%;
}


.code-line {
    height: 7px;

    background: #536174;

    border-radius: 10px;

    margin: 15px 0;
}


.code-line.long {
    width: 85%;
}


.code-line.medium {
    width: 60%;
}


.code-line.short {
    width: 35%;
}


.code-symbol {
    margin-top: 30px;

    font-size: 50px;

    font-weight: bold;

    color: #287cff;
}


/* =========================
   SECTIONS
========================= */

.section {
    max-width: 1200px;

    margin: auto;

    padding: 120px 7%;
}


.light-section {
    max-width: none;

    background: #eef3f9;

    padding-left: 7%;

    padding-right: 7%;
}


.section-heading {
    max-width: 650px;
}


.section-heading > p,
.contact-label {
    color: #287cff;

    font-size: 12px;

    letter-spacing: 2px;

    font-weight: bold;

    margin-bottom: 18px;
}


.section-heading h2,
.contact h2 {
    font-size: clamp(40px, 6vw, 65px);

    line-height: 1;

    letter-spacing: -2px;
}


.section-heading h2 span,
.contact h2 span {
    color: #287cff;
}


/* =========================
   ABOUT
========================= */

#about {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: center;
}


.about-text {
    color: #657184;

    font-size: 17px;
}


.about-text p {
    margin-bottom: 20px;
}


/* =========================
   SKILLS
========================= */

.skill-grid {
    max-width: 1200px;

    margin: 60px auto 0;

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}


.skill-card {
    background: white;

    border: 1px solid #dfe5ed;

    border-radius: 16px;

    padding: 32px;

    transition: 0.3s;
}


.skill-card:hover {
    transform: translateY(-8px);

    box-shadow:
        0 20px 50px
        rgba(16, 26, 43, 0.08);
}


.number {
    color: #287cff;

    font-size: 13px;

    font-weight: bold;

    margin-bottom: 45px;
}


.skill-card h3 {
    font-size: 23px;

    margin-bottom: 12px;
}


.skill-card p {
    color: #687589;
}


/* =========================
   PROJECTS
========================= */

.project-list {
    margin-top: 55px;
}


.project-card {
    display: grid;

    grid-template-columns: 100px 1fr;

    gap: 30px;

