/* =========================
   JOURNEY
========================= */

.journey {
    background: #101a2b;

    color: white;

    max-width: none;

    padding-left: 15%;

    padding-right: 15%;
}


.journey .section-heading > p {
    color: #6da2ff;
}


.journey .section-heading h2 span {
    color: #6da2ff;
}


.journey-text {
    max-width: 700px;

    color: #aeb9c9;

    font-size: 18px;

    margin-top: 30px;
}


/* =========================
   CONTACT
========================= */

.contact {
    text-align: center;

    padding: 150px 7%;

    background: #f7f5ef;
}


.contact-description {
    max-width: 550px;

    margin: 25px auto 35px;

    color: #697689;

    font-size: 17px;
}


.social-links {
    display: flex;

    justify-content: center;

    gap: 12px;

    flex-wrap: wrap;
}


.social-links a {
    padding: 12px 22px;

    border: 1px solid #d4dce6;

    border-radius: 8px;

    background: white;

    color: #101a2b;

    text-decoration: none;

    font-weight: bold;

    transition: 0.3s;
}


.social-links a:hover {
    background: #287cff;

    border-color: #287cff;

    color: white;

    transform: translateY(-3px);
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 30px 7%;

    border-top: 1px solid #dfe3e8;

    display: flex;

    justify-content: space-between;

    color: #788494;

    font-size: 13px;
}


footer strong {
    color: #101a2b;

    letter-spacing: 2px;
}


/* =========================
   ANIMATIONS
========================= */

@keyframes fadeUp {

    from {
        opacity: 0;

        transform: translateY(30px);
    }

    to {
        opacity: 1;

        transform: translateY(0);
    }
}


@keyframes float {

    0%,
    100% {
        transform:
            rotate(4deg)
            translateY(0);
    }

    50% {
        transform:
            rotate(4deg)
            translateY(-15px);
    }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 850px) {


    .navbar {
        padding: 18px 6%;
    }


    nav {
        display: none;
    }


    .hero {
        padding: 130px 7% 80px;

        text-align: center;

        flex-direction: column;

        justify-content: center;
    }


    .hero-content {
        display: flex;

        flex-direction: column;

        align-items: center;
    }


    .brand-name {
        font-size: 32px;

        letter-spacing: 3px;
    }


    .hero h1 {
        letter-spacing: -2px;
    }


    .hero-description {
        margin-left: auto;

        margin-right: auto;
    }


    .hero-buttons {
        justify-content: center;
    }


    .hero-visual {
        width: 300px;

        height: 300px;
    }


    .tech-card {
        width: 260px;
    }


    #about {
        grid-template-columns: 1fr;

        gap: 40px;
    }


    .skill-grid {
        grid-template-columns: 1fr;
    }


    .journey {
        padding-left: 7%;

        padding-right: 7%;
    }


    .project-card {
        grid-template-columns:
            50px 1fr;
    }


    footer {
        flex-direction: column;

        gap: 10px;

        text-align: center;
    }

}



